name = "moonbitstack/moonmime"

version = "0.2.2"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonmime"

license = "Apache-2.0"

keywords = [
  "mime",
  "media-type",
  "mime-type",
  "content-type",
  "mimetypes",
  "multipart",
  "form-data",
  "content-disposition",
  "quoted-printable",
  "encoded-word",
  "charset",
  "rfc2045",
  "rfc2046",
  "rfc2047",
  "rfc6838",
  "rfc7578",
  "rfc6266",
  "moonbit",
]

description = "MIME for MoonBit: media types, Content-Disposition and multipart bodies."

source = "src"

import {
  "moonbitstack/moonbase@0.4.2",
}
