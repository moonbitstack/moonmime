///|
fn mime_diff_2() -> Array[(String, String)] {
  [
    (".xwd", "application/octet-stream"),
    (".xz", "application/x-xz"),
    (".yaml", "application/yaml"),
    (".yml", "application/yaml"),
    (".zip", "application/zip"),
    (".zst", "application/zstd"),
  ]
}

///|
fn mime_diff_cases() -> Array[(String, String)] {
  let out : Array[(String, String)] = []
  out.append(mime_diff_1()[:])
  out.append(mime_diff_2()[:])
  out
}

///|
/// Replay the references' full extension list against the registry.
test "the references' extensions all replay" {
  for pair in mime_diff_cases() {
    assert_eq(@moonmime.guess_type(pair.0[:]), pair.1)
  }
}
